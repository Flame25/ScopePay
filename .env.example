# Backend
PORT=8080
DEV_MODE=1
# sqlite | postgres
DB_DRIVER=sqlite
DB_DSN=scope_pay.db
# example postgres DSN:
# DB_DSN=host=localhost user=scopepay password=scopepay dbname=scopepay port=5432 sslmode=disable
# comma-separated allowed browser origins
CORS_ORIGINS=http://localhost:5173

# Web (Vite) — leave empty to use the dev proxy (/api -> localhost:8080)
VITE_API_URL=
